rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection (profile info readable by authenticated users, writable only by owner)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Personal recipe subcollection — only the owner can manage their own collection
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Global Recipes collection — shared, public catalog
    match /recipes/{recipeId} {
      // Any authenticated user can read any global recipe
      allow read: if isAuthenticated();

      // Any authenticated user can create a new global recipe (during ingest)
      // The createdBy field must match the requesting user's UID
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;

      // Global recipes are immutable after creation (no update/delete from clients)
      // Updates and deletions are not allowed on the global recipe document
      allow update, delete: if false;

      // Translations subcollection — any authenticated user can read and contribute
      // translations (they are shared across all users for the same recipe)
      match /translations/{langCode} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // 3. Shopping Lists collection (private to the owner)
    match /shopping_lists/{listId} {
      allow read, write: if isOwner(listId);
    }

    // 4. Global Language collection (read-only for clients)
    match /language/{langId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
