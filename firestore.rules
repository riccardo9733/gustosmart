rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users collection (profile info readable by authenticated users, writable only by owner)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Personal recipe subcollection — only the owner can manage their own collection
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }

      // Personal folders subcollection — only the owner can manage their own folders
      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Global Recipes collection — shared, public catalog
    match /recipes/{recipeId} {
      // Any authenticated user can read any global recipe
      allow read: if isAuthenticated();

      // Any authenticated user can create a new global recipe (during ingest)
      // The createdBy field must match the requesting user's UID
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;

      // Global recipes are immutable after creation, EXCEPT for setting the dietary flags when missing
      allow update: if isAuthenticated() && (
        (!("isVegan" in resource.data) || resource.data.isVegan == null) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVegan', 'isVegetarian', 'isLactoseFree', 'isGlutenFree'])
      );
      allow delete: if false;

      // Translations subcollection — any authenticated user can read and contribute
      // translations (they are shared across all users for the same recipe)
      match /translations/{langCode} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Versions subcollection — any authenticated user can read and write alternative versions
      match /versions/{versionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();

        match /translations/{langCode} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }
    }

    // 3. Shopping Lists collection (private to the owner)
    match /shopping_lists/{listId} {
      allow read, write: if isOwner(listId);
    }

    // 4. Global Language collection (read-only for clients)
    match /language/{langId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 5. Analytics Events collection (writeable by anyone, readable only by admins)
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
