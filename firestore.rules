rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocumentOwner() {
      return isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    function willBeDocumentOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Recipes collection
    match /recipes/{recipeId} {
      // Allow read/update/delete only if user owns the recipe
      allow read, update, delete: if isDocumentOwner();
      // Allow creation if the user is assigning the recipe to themselves
      allow create: if willBeDocumentOwner();

      // Subcollection for translations
      match /translations/{langCode} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/recipes/$(recipeId)).data.userId == request.auth.uid;
      }
    }

    // 3. Shopping Lists collection
    match /shopping_lists/{listId} {
      // Allow read/update/delete only if user owns the shopping list
      allow read, update, delete: if isDocumentOwner();
      // Allow creation if the user is assigning the list to themselves
      allow create: if willBeDocumentOwner();
    }

    // 4. Global Language collection
    match /language/{langId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
